# Copy to .env to override defaults. All values are optional.
GENNAI_PAGE_TIMEOUT_MS=30000   # max time for the initial page load
GENNAI_ACTION_TIMEOUT_MS=5000  # per-action timeout inside generated tests
GENNAI_SETTLE_MS=2000          # wait after load so late-rendered elements appear
GENNAI_MAX_ELEMENTS=40         # cap on elements explored per page
GENNAI_MAX_TESTS=25            # cap on generated tests (--max-tests overrides)
GENNAI_RUN_TIMEOUT_S=600       # time limit for the whole generated pytest run
GENNAI_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING or ERROR
GENNAI_HISTORY_DIR=runs/history  # one append-only <site>.jsonl per site (--no-history skips it)
GENNAI_FLAKY_WINDOW=5          # flaky = passed and failed within this many recent runs

# Optional LLM step (OpenAI-compatible endpoints). Providers without a key are skipped.
GENNAI_LLM_PROVIDERS=gemini,gemma,openrouter  # ordered fallback list; "none" disables
GEMINI_API_KEY=                         # empty = provider not used; get one at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite      # gemini-3.8-flash is stronger but returned 503 (high demand) during testing
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_RPM=10                           # Google does not publish per-model free RPM; see your AI Studio project
GEMMA_API_KEY=${GEMINI_API_KEY}         # fallback: Gemma on the same Gemini API key (free tier)
GEMMA_MODEL=gemma-4-31b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMMA_RPM=10
OPENROUTER_API_KEY=                     # empty = provider not used
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_RPM=18                       # free models are limited to 20/min and 50/day, 1000/day after buying 10 credits
GENNAI_LLM_MAX_CALLS=3                  # hard cap on HTTP attempts per run (fallbacks and the retry pass included)
GENNAI_LLM_MAX_OUTPUT_TOKENS=4096       # max_tokens sent to the model
GENNAI_LLM_TIMEOUT_S=120                # per-request timeout (Gemma thinks before answering)
GENNAI_LLM_MAX_INPUT_CHARS=12000        # cap on page data sent to the model
